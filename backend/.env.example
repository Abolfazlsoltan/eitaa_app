# Copy to backend/.env locally. Never commit the real .env file.
# Generate a unique Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=replace-with-a-new-fernet-key
DATABASE_URL=sqlite:///./data.db
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=
MEDIA_DIR=media
TZ_OFFSET_MIN=210
